          "onDarkBrown": 6.1,
          "onBlack": 9.8
        }
      }
    },
    "accent": {
      "ivory": {
        "value": "#EFEBE9",
        "name": "--color-accent-1",
        "description": "Warm ivory accent",
        "usage": "Card backgrounds, form fields, subtle highlights",
        "contrastRatio": {
          "onDarkBrown": 12.7,
          "onBlack": 16.4
        }
      },
      "green": {
        "value": "#4E6151",
        "name": "--color-accent-2",
        "description": "Muted forest green accent",
        "usage": "Special offers, organic products, category indicators",
        "contrastRatio": {
          "onWhite": 6.3,
          "onLightBeige": 4.9
        }
      }
    },
    "neutral": {
      "background": {
        "value": "#FFF8F3",
        "name": "--color-bg",
        "description": "Off-white background color",
        "usage": "Main application background",
        "contrastRatio": {
          "withTextPrimary": 16.2,
          "withTextSecondary": 9.5
        }
      },
      "surface": {
        "value": "#F5E9DF",
        "name": "--color-surface",
        "description": "Light beige surface color",
