{
  "colors": {
    "primary": {
      "base": {
        "value": "#5D4037",
        "name": "--color-primary",
        "description": "Deep chocolate brown, primary brand color",
        "usage": "Primary buttons, brand elements, navigation highlights",
        "contrastRatio": {
          "onWhite": 7.5,
          "onLightBeige": 5.8
        }
      },
      "variant": {
        "value": "#3E2723",
        "name": "--color-primary-variant",
        "description": "Darker chocolate brown for active states",
        "usage": "Button active states, selected items, focused elements",
        "contrastRatio": {
          "onWhite": 11.2,
          "onLightBeige": 8.9
        }
      },
      "light": {
        "value": "#8D6E63",
        "name": "--color-primary-light",
        "description": "Lighter chocolate brown",
        "usage": "Hover states, secondary elements, decorative accents",
        "contrastRatio": {
          "onWhite": 4.3,
          "onDark": 5.1
        }
      }
    },
    "secondary": {
      "base": {
        "value": "#D7CCC8",
        "name": "--color-secondary",
        "description": "Caramel tan accent color",
        "usage": "Secondary buttons, cards, section backgrounds",
        "contrastRatio": {
          "onDarkBrown": 8.2,
          "onBlack": 12.5
        }
      },
      "variant": {
        "value": "#BCAAA4",
        "name": "--color-secondary-variant",
        "description": "Lighter caramel accent",
        "usage": "Hover states for secondary elements, subtle backgrounds",
